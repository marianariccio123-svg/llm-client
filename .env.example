GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Proveedor a usar: gemini | openai | anthropic (default: gemini)
PROVIDER=gemini
# Opcional: pisa el modelo de chat del proveedor (ej. si se agota la cuota diaria)
# CHAT_MODEL=gemini-flash-lite-latest

# --- Pre-entrega 4: Pinecone ---
# API key gratuita del plan Starter: https://app.pinecone.io
PINECONE_API_KEY=
# Nombre del índice Serverless. Lo crea `python setup_index.py` si no existe.
INDEX_NAME=asyncio-docs
# Namespace dentro del índice (particiona el corpus lógicamente)
PINECONE_NAMESPACE=python-asyncio
# Región del índice Serverless. us-east-1 en AWS es la única gratuita del plan Starter.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Opcional: pisa el tamaño de chunk (en tokens) de la ingesta
# CHUNK_SIZE=500
# CHUNK_OVERLAP=60
# Opcional: pesos del EnsembleRetriever, "peso_bm25,peso_denso"
# ENSEMBLE_WEIGHTS=0.3,0.7

# --- Pre-entrega 5: agente con LangGraph ---
# Techo de pasos del grafo, para que un agente en bucle no corra para siempre
# RECURSION_LIMIT=10
