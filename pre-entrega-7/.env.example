# ===========================================================================
# Pre-entrega 7 — API de producción
# Copiá este archivo al .env de la RAÍZ del repo y completá los valores.
# El .env nunca se sube: está en .gitignore.
# ===========================================================================

# --- Redis (obligatorio) ---
# El estado de los jobs y los checkpoints del grafo viven acá.
# IMPORTANTE: tiene que ser un Redis con el módulo RediSearch. Un
# `apt install redis-server` pelado NO alcanza: el checkpointer de LangGraph
# crea índices de búsqueda y falla al arrancar.
#   - Redis Cloud free (incluye RediSearch): https://redis.io/try-free
#   - Local: docker compose up -d redis   (la imagen redis/redis-stack ya lo trae)
REDIS_URL=redis://default:TU_PASSWORD@TU_HOST:TU_PUERTO

# Prefijo de las claves. Cambialo si compartís la base con otro entorno.
REDIS_PREFIJO=auditoria
# Cuánto se conservan los jobs y sus checkpoints (segundos). Por defecto 7 días.
TTL_JOB_SEGUNDOS=604800

# --- Observabilidad (obligatorio para las capturas del dashboard) ---
PLATAFORMA_TRAZAS=langsmith
LANGSMITH_API_KEY=lsv2_pt_...
# El costo y los percentiles de latencia se agregan POR PROYECTO. Sin esto, las
# corridas caen en "default" y se mezclan con cualquier otra cosa.
LANGSMITH_PROJECT=auditoria-multiagente

# Alternativa: Arize Phoenix. Requiere un endpoint OTLP (Phoenix Cloud o un
# Phoenix propio) y los paquetes comentados en requirements.txt.
# PLATAFORMA_TRAZAS=phoenix
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/v1/traces
# PHOENIX_API_KEY=...

# --- Proveedor del modelo ---
PROVIDER=gemini
GEMINI_API_KEY=...
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Modelo CONCRETO, no un alias `-latest`. LangSmith deriva el costo de una
# tabla de precios indexada por nombre de modelo, y los alias no están en ella:
# con `gemini-flash-lite-latest` las trazas llegan con los tokens bien contados
# y el costo en blanco.
MODELO_GEMINI_API=gemini-3.1-flash-lite

# --- Límite de tasa del proveedor ---
# Llamadas por segundo al modelo, sumando todos los jobs del proceso. El free
# tier de Gemini permite pocas por minuto: sin esto, 5 peticiones concurrentes
# terminan en 429 RESOURCE_EXHAUSTED.
LLM_LLAMADAS_POR_SEGUNDO=0.5
LLM_RAFAGA_MAXIMA=3
LLM_MAX_REINTENTOS=6

# --- Workers y cola ---
CANTIDAD_WORKERS=3
TAMANIO_COLA=100
TIMEOUT_JOB_SEGUNDOS=300

# --- Vector DB del módulo 4 (opcional) ---
# Sin esto, la búsqueda documental cae a BM25 local y el sistema funciona igual.
PINECONE_API_KEY=
INDEX_NAME=asyncio-docs
